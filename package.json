{
  "name": "urvo",
  "description": "A multi-purpose discord bot with over 65 commands spanning across 8 categories!",
  "version": "2.0.1",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "license": "MIT",
  "author": "Visakan Kirubakaran",
  "repository": {
    "type": "git",
    "url": "https://github.com/vikiru/Urvo.git"
  },
  "bugs": {
    "url": "https://github.com/vikiru/Urvo/issues"
  },
  "keywords": ["Urvo", "discord", "bot", "discord.js", "sqlite", "sequelize"],
  "main": "main.js",
  "scripts": {
    "start": "node .",
    "deploy": "node deploy.js",
    "init-db": "node initializeDatabase.js",
    "test": "mocha test/test.js",
    "lint": "biome lint",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "unused": "knip",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "ms": "^2.1.3",
    "node-fetch": "^3.3.2",
    "path": "^0.12.7",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/git": "^11.0.1",
    "@types/chai": "~5.2.3",
    "@types/mocha": "~10.0.10",
    "@types/ms": "~2.1.0",
    "@types/node": "^26.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "chai": "^6.2.2",
    "chai-http": "^5.1.2",
    "dotenv": "^17.4.2",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "mocha": "^12.0.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=16.9"
  }
}
